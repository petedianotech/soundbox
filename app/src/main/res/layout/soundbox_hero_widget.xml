<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hero_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hero_bg"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Album Art Section -->
    <ImageView
        android:id="@+id/widget_hero_album_art"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_art_rounded"
        android:src="@drawable/ic_music_note"
        android:contentDescription="Album Art" />

    <!-- Details and Controls Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <!-- Hi-Res Badge -->
        <TextView
            android:id="@+id/widget_hero_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOUNDBOX • HI-RES DSP"
            android:textColor="#00E5FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:maxLines="1" />

        <!-- Song Title -->
        <TextView
            android:id="@+id/widget_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soundbox Audio"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

        <!-- Artist -->
        <TextView
            android:id="@+id/widget_hero_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Poweramp-Grade Audio Engine"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/widget_hero_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_prev_widget"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/widget_hero_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_widget"
                android:contentDescription="Play or Pause"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/widget_hero_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next_widget"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
